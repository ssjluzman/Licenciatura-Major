  RowBox[{
   RowBox[{
    RowBox[{"\[Chi]", "[", "t_", "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"A", "[", "i", "]"}], "[", "t", "]"}], "/.", " ", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "-", 
       RowBox[{"B", "[", "i", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "nfinal"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Z", "[", "t_", "]"}], ":=", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Chi]", "[", "t", "]"}], "]"}], "^", "2"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "nfinal"}], "]"}], " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"\[Chi]", "[", "t", "]"}], "]"}], "^", "2"}]}], "]"}], "/", 
    RowBox[{"Z", "[", "t", "]"}]}]}], ";"}]}], "Input",
