 RowBox[{
  RowBox[{
   RowBox[{"\[Epsilon]", "=", "0.75"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Acoplamientos", ":", 
