    "Definimos", " ", "los", " ", "acoplamientos", " ", "para", " ", "cada", " ",
      "enlace", " ", "entre", " ", "i", " ", "e", " ", "i"}], "+", "1"}], 
   "*)"}]}], "\n", 
 RowBox[{
