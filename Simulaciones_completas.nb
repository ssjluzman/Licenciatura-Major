 RowBox[{
  RowBox[{
   RowBox[{"beta", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "\[Epsilon]"}], ")"}], "/", "2"}]}], ";"}], 
  "           ", 
  RowBox[{"(*", 
   RowBox[{"Enlace", " ", "d\[EAcute]bil"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"betaprima", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Epsilon]"}], ")"}], "/", "2"}]}], ";"}], "      ", 
  RowBox[{"(*", 
