  RowBox[{
   RowBox[{"beta", "[", "eps_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "eps"}], ")"}], "/", "2"}]}], ";"}], "\n", 
