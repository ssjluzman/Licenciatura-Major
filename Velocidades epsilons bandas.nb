Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "==="}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"VELOCIDAD", " ", "DE", " ", "GRUPO"}], "===", "===", "==="}], 
     "="}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"v", "[", 
      RowBox[{"k_", ",", "eps_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"beta", "[", "eps", "]"}]}], " ", 
      RowBox[{"betaprima", "[", "eps", "]"}], " ", 
      RowBox[{
       RowBox[{"Sin", "[", "k", "]"}], "/", 
       RowBox[{"e", "[", 
        RowBox[{"k", ",", "eps"}], "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
